<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compile check (no build output used) of the Editor and Game assemblies against the Unity editor's managed
       assemblies (UnityEditor.*Module and UnityEngine.*Module under Editor/Data/Managed/UnityEngine), so editor
       API mistakes surface before CI. URP ships as source inside its package, so the few URP types ProjectSetup
       touches are stood in by stubs/UrpStubs.cs (keep them in step with the real API when the setup grows). -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <UnityManaged Condition="'$(UnityManaged)' == ''">$(HOME)/unity-managed</UnityManaged>
    <NoWarn>CS1701;CS1702</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../unity/Assets/SecondFace/Editor/**/*.cs" />
    <Compile Include="../unity/Assets/SecondFace/Game/**/*.cs" />
    <!-- URP ships as source: its compiled assemblies exist once the editor has opened the project; on a fresh machine
         the few URP types ProjectSetup touches are stood in by stubs/UrpStubs.cs. -->
    <Compile Include="stubs/UrpStubs.cs" Condition="!Exists('../unity/Library/ScriptAssemblies/Unity.RenderPipelines.Universal.Runtime.dll')" />
    <ProjectReference Include="SecondFace.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="$(UnityManaged)/UnityEngine/*.dll" />
    <Reference Include="../unity/Library/ScriptAssemblies/Unity.RenderPipelines.Universal.Runtime.dll" Condition="Exists('../unity/Library/ScriptAssemblies/Unity.RenderPipelines.Universal.Runtime.dll')" />
    <Reference Include="../unity/Library/ScriptAssemblies/Unity.RenderPipelines.Universal.Editor.dll" Condition="Exists('../unity/Library/ScriptAssemblies/Unity.RenderPipelines.Universal.Editor.dll')" />
    <Reference Include="../unity/Library/ScriptAssemblies/Unity.RenderPipelines.Core.Runtime.dll" Condition="Exists('../unity/Library/ScriptAssemblies/Unity.RenderPipelines.Core.Runtime.dll')" />
    <Reference Include="../unity/Library/ScriptAssemblies/Unity.RenderPipelines.Core.Editor.dll" Condition="Exists('../unity/Library/ScriptAssemblies/Unity.RenderPipelines.Core.Editor.dll')" />
    <Reference Include="../unity/Library/ScriptAssemblies/Unity.RenderPipelines.GPUDriven.Runtime.dll" Condition="Exists('../unity/Library/ScriptAssemblies/Unity.RenderPipelines.GPUDriven.Runtime.dll')" />
    <!-- Addressables ships as a package; its compiled assemblies exist once the editor has opened the project. -->
    <Reference Include="../unity/Library/ScriptAssemblies/Unity.Addressables.dll" Condition="Exists('../unity/Library/ScriptAssemblies/Unity.Addressables.dll')" />
    <Reference Include="../unity/Library/ScriptAssemblies/Unity.Addressables.Editor.dll" Condition="Exists('../unity/Library/ScriptAssemblies/Unity.Addressables.Editor.dll')" />
    <Reference Include="../unity/Library/ScriptAssemblies/Unity.ResourceManager.dll" Condition="Exists('../unity/Library/ScriptAssemblies/Unity.ResourceManager.dll')" />
    <Reference Include="../unity/Library/ScriptAssemblies/Unity.ScriptableBuildPipeline.dll" Condition="Exists('../unity/Library/ScriptAssemblies/Unity.ScriptableBuildPipeline.dll')" />
    <Reference Include="../unity/Library/ScriptAssemblies/Unity.ScriptableBuildPipeline.Editor.dll" Condition="Exists('../unity/Library/ScriptAssemblies/Unity.ScriptableBuildPipeline.Editor.dll')" />
  </ItemGroup>
</Project>
