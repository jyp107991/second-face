/* The Second Face: the one theme (BUILD_PLAN P5 step 3, DESIGN_UNITY §6 and §8).
   A field notebook and a map: paper, ink, pencil, a rust mark and an ochre highlight; plates of dark glass over the
   world for what stays on screen. Two OFL faces: Barlow for the interface, Literata for the notebook. No cursive.
   Units are panel pixels at the 1280x720 reference (scaled with the screen's height): on a 6.1-inch phone one unit is
   about 0.09 mm, so body text (26) is about 14 sp and a touch target (80) about 7 mm. */

:root {
    --paper: #EEE6D3;
    --paper-deep: #E3D8BF;
    --paper-edge: #C9B994;
    --ink: #24201B;
    --ink-soft: #4B433A;
    --pencil: #7C7266;
    --rust: #A1402A;
    --ochre: #C48A2C;
    --sage: #5D7354;
    --slate: #2E4A63;
    --plate: rgba(22, 19, 16, 0.78);
    --plate-text: #F2EADB;
    --plate-dim: #B9AE9C;
    --scrim: rgba(12, 10, 8, 0.55);

    /* text sizes: every font size is one of these, so the settings' text size (a class on the root, below) scales
       them all */
    --fs-16: 16px;
    --fs-18: 18px;
    --fs-20: 20px;
    --fs-21: 21px;
    --fs-22: 22px;
    --fs-23: 23px;
    --fs-24: 24px;
    --fs-25: 25px;
    --fs-26: 26px;
    --fs-28: 28px;
    --fs-30: 30px;
    --fs-32: 32px;
    --fs-34: 34px;
    --fs-36: 36px;
    --fs-40: 40px;
    --fs-42: 42px;
    --fs-44: 44px;
    --fs-48: 48px;
    --fs-72: 72px;
    --touch: 80px;
    --gutter: 16px;
    --edge: 24px;

    /* the default theme's text colours, so plain labels and fields read as ink */
    --unity-colors-default-text: #24201B;
    --unity-colors-label-text: #24201B;

    -unity-font-definition: url("../Fonts/Barlow-Regular.asset");
    font-size: var(--fs-26);
    color: #24201B;
}

/* ---- the settings (P5.3j): text size and contrast, as classes on the root element ---- */
.sf-root { font-size: var(--fs-26); }
.sf-text-0 { --fs-16: 14px; --fs-18: 16px; --fs-20: 18px; --fs-21: 19px; --fs-22: 20px; --fs-23: 21px; --fs-24: 22px; --fs-25: 22px; --fs-26: 23px; --fs-28: 25px; --fs-30: 27px; --fs-32: 29px; --fs-34: 31px; --fs-36: 32px; --fs-40: 36px; --fs-42: 38px; --fs-44: 40px; --fs-48: 43px; --fs-72: 65px; }
.sf-text-2 { --fs-16: 18px; --fs-18: 21px; --fs-20: 23px; --fs-21: 24px; --fs-22: 25px; --fs-23: 26px; --fs-24: 28px; --fs-25: 29px; --fs-26: 30px; --fs-28: 32px; --fs-30: 34px; --fs-32: 37px; --fs-34: 39px; --fs-36: 41px; --fs-40: 46px; --fs-42: 48px; --fs-44: 51px; --fs-48: 55px; --fs-72: 83px; }
.sf-text-3 { --fs-16: 21px; --fs-18: 23px; --fs-20: 26px; --fs-21: 27px; --fs-22: 29px; --fs-23: 30px; --fs-24: 31px; --fs-25: 32px; --fs-26: 34px; --fs-28: 36px; --fs-30: 39px; --fs-32: 42px; --fs-34: 44px; --fs-36: 47px; --fs-40: 52px; --fs-42: 55px; --fs-44: 57px; --fs-48: 62px; --fs-72: 94px; }
.sf-contrast {
    --ink-soft: #24201B;
    --pencil: #3D362E;
    --paper-edge: #8C7B58;
    --plate: rgba(8, 7, 6, 0.94);
    --plate-text: #FFFFFF;
    --plate-dim: #E4DBCB;
    --scrim: rgba(6, 5, 4, 0.78);
}

/* ---- structure ---- */
.sf-row { flex-direction: row; align-items: center; }
.sf-col { flex-direction: column; }
.sf-grow { flex-grow: 1; }
.sf-safe { flex-grow: 1; }
.sf-edge { margin: var(--edge); }
.sf-gap { margin-right: var(--gutter); margin-bottom: var(--gutter); }

/* ---- surfaces ---- */
.sf-page { background-color: var(--paper); }
.sf-page--deep { background-color: var(--paper-deep); }
.sf-plate {
    background-color: var(--plate);
    border-radius: 6px;
    padding: 10px 16px;
}
.sf-plate Label { color: var(--plate-text); }
.sf-scrim { background-color: var(--scrim); }
.sf-rule { height: 2px; background-color: var(--paper-edge); margin: 12px 0; }

/* ---- type ---- */
.sf-title {
    -unity-font-definition: url("../Fonts/Literata-SemiBold.asset");
    font-size: var(--fs-42);
    color: var(--ink);
}
.sf-heading {
    -unity-font-definition: url("../Fonts/Barlow-SemiBold.asset");
    font-size: var(--fs-32);
    color: var(--ink);
}
.sf-label {
    -unity-font-definition: url("../Fonts/Barlow-SemiBold.asset");
    font-size: var(--fs-22);
    letter-spacing: 2px;
    color: var(--pencil);
}
.sf-body {
    -unity-font-definition: url("../Fonts/Barlow-Regular.asset");
    font-size: var(--fs-26);
    white-space: normal;
}
.sf-book {
    -unity-font-definition: url("../Fonts/Literata-Regular.asset");
    font-size: var(--fs-26);
    color: var(--ink);
    white-space: normal;
}
.sf-note {
    -unity-font-definition: url("../Fonts/Literata-Italic.asset");
    font-size: var(--fs-26);
    color: var(--ink-soft);
    white-space: normal;
}
.sf-fine { font-size: var(--fs-22); color: var(--pencil); white-space: normal; }
.sf-mark { color: var(--rust); }
.sf-lead { color: var(--slate); }

/* ---- buttons (selectors match the default theme's specificity so ours win) ---- */
.sf-button {
    min-height: var(--touch);
    min-width: var(--touch);
    padding: 0 28px;
    margin: 0;
    border-width: 0;
    border-radius: 3px;
    background-color: var(--ink);
    color: var(--paper);
    -unity-font-definition: url("../Fonts/Barlow-SemiBold.asset");
    font-size: var(--fs-26);
    letter-spacing: 1px;
    -unity-text-align: middle-center;
}
.sf-button:enabled:hover { background-color: var(--ink-soft); }
.sf-button:enabled:active { background-color: #000000; }
.sf-button:enabled:focus { border-width: 3px; border-color: var(--ochre); }
.sf-button:disabled { opacity: 0.45; background-color: var(--ink); }
.sf-button--quiet { background-color: rgba(0, 0, 0, 0); color: var(--ink); border-width: 2px; border-color: var(--ink); }
.sf-button--quiet:enabled:hover { background-color: rgba(36, 32, 27, 0.08); }
.sf-button--quiet:enabled:active { background-color: rgba(36, 32, 27, 0.16); }
.sf-button--plate { background-color: var(--plate); color: var(--plate-text); }
.sf-button--plate:enabled:hover { background-color: rgba(40, 35, 30, 0.86); }
.sf-button--plate:enabled:active { background-color: rgba(8, 7, 6, 0.9); }

/* ---- the start card (TitleCard) ---- */
.sf-title-card { background-color: rgba(14, 12, 9, 0.45); }
.sf-title-card__body { justify-content: center; align-items: center; }
.sf-title-card__name {
    -unity-font-definition: url("../Fonts/Literata-SemiBold.asset");
    font-size: var(--fs-72);
    letter-spacing: 6px;
    color: var(--plate-text);
    -unity-text-align: middle-center;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.6);
}
.sf-title-card__status {
    -unity-font-definition: url("../Fonts/Barlow-SemiBold.asset");
    font-size: var(--fs-26);
    letter-spacing: 2px;
    margin-top: 18px;
    color: var(--plate-text);
    -unity-text-align: middle-center;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.7);
}
.sf-title-card__detail {
    font-size: var(--fs-22);
    margin-top: 10px;
    max-width: 80%;
    color: var(--plate-dim);
    white-space: normal;
    -unity-text-align: middle-center;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.7);
}

/* ---- modal questions ---- */
.sf-modal { justify-content: center; align-items: center; background-color: var(--scrim); }
.sf-card {
    background-color: var(--paper);
    border-radius: 4px;
    padding: 28px 32px;
    max-width: 70%;
}

/* ---- the HUD (Hud.cs): plates over the world inside the safe area ---- */
.sf-hud__area { flex-grow: 1; }
.sf-hud__objective {
    position: absolute;
    left: 20px;
    top: 20px;
    max-width: 46%;
    padding: 10px 18px 12px 18px;
}
.sf-hud__when {
    -unity-font-definition: url("../Fonts/Barlow-SemiBold.asset");
    font-size: var(--fs-20);
    letter-spacing: 2px;
    color: var(--plate-dim);
}
.sf-hud__quest {
    -unity-font-definition: url("../Fonts/Barlow-SemiBold.asset");
    font-size: var(--fs-22);
    margin-top: 4px;
    color: #E0A645;
}
.sf-hud__line { font-size: var(--fs-26); margin-top: 2px; color: var(--plate-text); white-space: normal; }

.sf-compass {
    position: absolute;
    right: 20px;
    top: 20px;
    width: 360px;
    height: 52px;
    background-color: var(--plate);
    border-radius: 6px;
    overflow: hidden;
}
.sf-compass__letter {
    position: absolute;
    left: -16px;
    width: 32px;
    top: 6px;
    -unity-font-definition: url("../Fonts/Barlow-SemiBold.asset");
    font-size: var(--fs-22);
    -unity-text-align: upper-center;
    color: var(--plate-text);
}

.sf-hud__party { position: absolute; left: 20px; bottom: 20px; flex-direction: row; align-items: flex-end; }
.sf-hud__member {
    width: 100px;
    margin-right: 12px;
    padding: 6px 6px 8px 6px;
    align-items: center;
    background-color: var(--plate);
    border-radius: 6px;
}
.sf-hud__face {
    width: 80px;
    height: 80px;
    border-radius: 4px;
    border-width: 2px;
    border-color: rgba(242, 234, 219, 0.5);
    background-color: #3A332B;
    -unity-background-scale-mode: scale-and-crop;
    justify-content: center;
    align-items: center;
}
.sf-hud__member--leader .sf-hud__face { border-color: #E0A645; }
.sf-hud__initial {
    -unity-font-definition: url("../Fonts/Literata-SemiBold.asset");
    font-size: var(--fs-40);
    color: var(--plate-dim);
}
.sf-hud__name {
    -unity-font-definition: url("../Fonts/Barlow-SemiBold.asset");
    font-size: var(--fs-20);
    margin-top: 4px;
    color: var(--plate-text);
    -unity-text-align: upper-center;
}
.sf-hud__bar {
    align-self: stretch;
    height: 8px;
    margin-top: 4px;
    border-radius: 4px;
    background-color: rgba(0, 0, 0, 0.55);
}
.sf-hud__fill { height: 100%; border-radius: 4px; background-color: #7E9A6F; }
.sf-hud__fill--low { background-color: #D49A3A; }
.sf-hud__fill--critical { background-color: #C4553A; }

.sf-hud__actions { position: absolute; right: 20px; bottom: 20px; flex-direction: row; }
.sf-hud__action {
    width: 100px;
    height: 100px;
    margin: 0 0 0 12px;
    padding: 0;
    border-width: 0;
    border-radius: 8px;
    background-color: var(--plate);
    color: var(--plate-text);
    align-items: center;
    justify-content: center;
}
.sf-hud__action:enabled:hover { background-color: rgba(40, 35, 30, 0.86); }
.sf-hud__action:enabled:active { background-color: rgba(8, 7, 6, 0.9); }
.sf-hud__action:enabled:focus { border-width: 3px; border-color: var(--ochre); }
.sf-hud__action-label {
    -unity-font-definition: url("../Fonts/Barlow-SemiBold.asset");
    font-size: var(--fs-20);
    margin-top: 4px;
    color: var(--plate-text);
}
.sf-icon { color: var(--plate-text); }

/* ---- the radial action menu (RadialMenu.cs) ---- */
.sf-radial { background-color: rgba(10, 8, 6, 0.18); }
.sf-radial__ring {
    position: absolute;
    scale: 0.7 0.7;
    opacity: 0;
    transition-property: scale, opacity;
    transition-duration: 0.12s;
    transition-timing-function: ease-out;
}
.sf-radial--open .sf-radial__ring { scale: 1 1; opacity: 1; }
.sf-radial__verb {
    position: absolute;
    width: 104px;
    height: 104px;
    margin: 0;
    padding: 0;
    border-width: 0;
    border-radius: 52px;
    background-color: rgba(30, 26, 22, 0.95);
    color: var(--plate-text);
    align-items: center;
    justify-content: center;
}
.sf-radial__verb:enabled:hover { background-color: rgba(48, 42, 36, 0.97); }
.sf-radial__verb:enabled:active { background-color: rgba(8, 7, 6, 0.95); }
.sf-radial__verb:enabled:focus { border-width: 3px; border-color: var(--ochre); }
.sf-radial__verb:disabled { opacity: 0.4; background-color: rgba(30, 26, 22, 0.95); }
.sf-radial__verb .sf-icon { color: var(--plate-text); }
.sf-radial__verb-label {
    -unity-font-definition: url("../Fonts/Barlow-SemiBold.asset");
    font-size: var(--fs-20);
    margin-top: 2px;
    color: var(--plate-text);
}
.sf-radial__hub {
    position: absolute;
    max-width: 196px;
    padding: 6px 12px;
    border-radius: 6px;
    background-color: rgba(30, 26, 22, 0.95);
}
.sf-radial__title {
    -unity-font-definition: url("../Fonts/Barlow-SemiBold.asset");
    font-size: var(--fs-22);
    color: #E0A645;
    white-space: normal;
    -unity-text-align: middle-center;
}

/* ---- the conversation panel (DialoguePanel.cs): a page at the right, the scene beside it ---- */
.sf-dialogue { flex-direction: row; justify-content: flex-end; }
.sf-dialogue__page {
    width: 46%;
    min-width: 560px;
    background-color: var(--paper);
    border-left-width: 3px;
    border-left-color: var(--paper-edge);
}
.sf-dialogue__page > .sf-safe { flex-grow: 1; }
.sf-dialogue__head {
    flex-direction: row;
    align-items: center;
    margin: 20px 24px 8px 24px;
}
.sf-dialogue__face {
    width: 96px;
    height: 96px;
    border-radius: 4px;
    border-width: 2px;
    border-color: var(--paper-edge);
    background-color: #3A332B;
    -unity-background-scale-mode: scale-and-crop;
    justify-content: center;
    align-items: center;
}
.sf-dialogue__initial {
    -unity-font-definition: url("../Fonts/Literata-SemiBold.asset");
    font-size: var(--fs-44);
    color: var(--plate-dim);
}
.sf-dialogue__speaker {
    -unity-font-definition: url("../Fonts/Literata-SemiBold.asset");
    font-size: var(--fs-32);
    margin-left: 16px;
    flex-shrink: 1;
    white-space: normal;
    color: var(--ink);
}
.sf-dialogue__scroll { flex-grow: 1; flex-shrink: 1; }
.sf-dialogue__scroll .unity-scroll-view__content-container { padding: 4px 24px 24px 24px; }
.sf-dialogue__log { margin-bottom: 4px; }
.sf-dialogue__logged-line {
    -unity-font-definition: url("../Fonts/Literata-Regular.asset");
    font-size: var(--fs-22);
    color: var(--pencil);
    white-space: normal;
    margin-bottom: 6px;
}
.sf-dialogue__logged-choice {
    -unity-font-definition: url("../Fonts/Literata-Italic.asset");
    font-size: var(--fs-22);
    color: var(--pencil);
    white-space: normal;
    margin-bottom: 12px;
    padding-left: 16px;
}
.sf-dialogue__line {
    -unity-font-definition: url("../Fonts/Literata-Regular.asset");
    font-size: var(--fs-28);
    color: var(--ink);
    white-space: normal;
    margin: 6px 0 12px 0;
}
.sf-dialogue__passive {
    border-left-width: 3px;
    border-left-color: var(--slate);
    padding: 2px 0 2px 12px;
    margin-bottom: 12px;
}
.sf-dialogue__passive-label {
    -unity-font-definition: url("../Fonts/Barlow-SemiBold.asset");
    font-size: var(--fs-20);
    letter-spacing: 2px;
    color: var(--slate);
}
.sf-dialogue__passive-text {
    -unity-font-definition: url("../Fonts/Literata-Italic.asset");
    font-size: var(--fs-24);
    color: var(--ink-soft);
    white-space: normal;
}
.sf-dialogue__options { margin-top: 4px; }
.sf-dialogue__option {
    flex-direction: row;
    align-items: center;
    min-height: 72px;
    margin: 0;
    padding: 8px 12px;
    border-width: 0;
    border-bottom-width: 1px;
    border-color: var(--paper-edge);
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    -unity-text-align: middle-left;
}
.sf-dialogue__option:enabled:hover { background-color: var(--paper-deep); }
.sf-dialogue__option:enabled:active { background-color: #D8CBAE; }
.sf-dialogue__option:enabled:focus { border-left-width: 4px; border-left-color: var(--ochre); }
.sf-dialogue__option:disabled { opacity: 0.45; background-color: rgba(0, 0, 0, 0); }
.sf-dialogue__number {
    -unity-font-definition: url("../Fonts/Barlow-SemiBold.asset");
    font-size: var(--fs-22);
    min-width: 34px;
    color: var(--pencil);
}
.sf-dialogue__check {
    -unity-font-definition: url("../Fonts/Barlow-SemiBold.asset");
    font-size: var(--fs-20);
    letter-spacing: 1px;
    padding: 2px 8px;
    margin-right: 10px;
    border-radius: 3px;
    background-color: var(--sage);
    color: var(--paper);
}
.sf-dialogue__check--unmet { background-color: rgba(0, 0, 0, 0); border-width: 2px; border-color: var(--rust); color: var(--rust); }
.sf-dialogue__option-text {
    -unity-font-definition: url("../Fonts/Barlow-Regular.asset");
    font-size: var(--fs-26);
    flex-shrink: 1;
    white-space: normal;
    color: var(--ink);
}
.sf-dialogue__option--seen .sf-dialogue__option-text { color: var(--pencil); }
.sf-dialogue__option--exit .sf-dialogue__option-text { -unity-font-definition: url("../Fonts/Literata-Italic.asset"); }

/* ---- the notebook (NotebookScreen.cs): a book open on a dark desk ---- */
.sf-notebook { background-color: #2B241E; }
.sf-notebook__head {
    flex-direction: row;
    align-items: center;
    margin: 12px 20px 8px 20px;
    min-height: 72px;
}
.sf-notebook__tab {
    min-height: 64px;
    margin: 0 8px 0 0;
    padding: 0 14px;
    border-width: 0;
    border-bottom-width: 3px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    -unity-font-definition: url("../Fonts/Barlow-SemiBold.asset");
    font-size: var(--fs-24);
    letter-spacing: 1px;
    color: var(--plate-dim);
}
.sf-notebook__tab:enabled:hover { background-color: rgba(255, 255, 255, 0.06); }
.sf-notebook__tab:enabled:active { background-color: rgba(255, 255, 255, 0.1); }
.sf-notebook__tab--on { color: var(--plate-text); border-color: var(--ochre); }
.sf-notebook__head .sf-button--quiet { color: var(--plate-text); border-color: var(--plate-dim); }
.sf-notebook__head .sf-button--quiet:enabled:hover { background-color: rgba(255, 255, 255, 0.06); }
.sf-notebook__pages {
    flex-grow: 1;
    flex-direction: row;
    margin: 0 16px 16px 16px;
    background-color: var(--paper);
    border-radius: 6px;
}
.sf-notebook__list { width: 40%; }
.sf-notebook__list .unity-scroll-view__content-container { padding: 16px 16px 24px 20px; }
.sf-notebook__gutter {
    width: 3px;
    margin: 16px 0;
    background-color: var(--paper-edge);
}
.sf-notebook__detail { flex-grow: 1; flex-shrink: 1; }
.sf-notebook__detail .unity-scroll-view__content-container { padding: 24px 36px 32px 32px; }
.sf-notebook__row {
    margin: 0;
    padding: 10px 12px;
    min-height: 72px;
    border-width: 0;
    border-bottom-width: 1px;
    border-color: var(--paper-edge);
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    align-items: flex-start;
    justify-content: center;
}
.sf-notebook__row:enabled:hover { background-color: var(--paper-deep); }
.sf-notebook__row--on { background-color: var(--paper-deep); border-left-width: 4px; border-left-color: var(--ochre); }
.sf-notebook__row-title {
    -unity-font-definition: url("../Fonts/Literata-Regular.asset");
    font-size: var(--fs-24);
    color: var(--ink);
    white-space: normal;
    -unity-text-align: middle-left;
}
.sf-notebook__row--closed .sf-notebook__row-title { color: var(--pencil); }
.sf-notebook__row-sub {
    font-size: var(--fs-20);
    margin-top: 2px;
    color: var(--pencil);
    -unity-text-align: middle-left;
}
.sf-notebook__empty {
    -unity-font-definition: url("../Fonts/Literata-Italic.asset");
    font-size: var(--fs-24);
    color: var(--pencil);
    margin: 12px 4px;
}
.sf-notebook__title {
    -unity-font-definition: url("../Fonts/Literata-SemiBold.asset");
    font-size: var(--fs-36);
    color: var(--ink);
    white-space: normal;
}
.sf-notebook__sub { font-size: var(--fs-20); color: var(--pencil); margin-top: 4px; }
.sf-notebook__track { align-self: flex-start; margin: 14px 0 6px 0; }
.sf-notebook__item { flex-direction: row; align-items: flex-start; margin-top: 12px; }
.sf-notebook__box {
    -unity-font-definition: url("../Fonts/Literata-Regular.asset");
    font-size: var(--fs-24);
    width: 32px;
    color: var(--rust);
}
.sf-notebook__item-text {
    -unity-font-definition: url("../Fonts/Literata-Regular.asset");
    font-size: var(--fs-25);
    flex-shrink: 1;
    white-space: normal;
    color: var(--ink);
}
.sf-notebook__item--done .sf-notebook__box { color: var(--sage); }
.sf-notebook__item--done .sf-notebook__item-text { color: var(--pencil); }
.sf-notebook__para {
    -unity-font-definition: url("../Fonts/Literata-Regular.asset");
    font-size: var(--fs-24);
    color: var(--ink-soft);
    white-space: normal;
    margin-top: 16px;
}

/* ---- the world map (MapScreen.cs): the surveyor's sheet on the desk ---- */
.sf-map { background-color: #2B241E; }
.sf-map__head { flex-direction: row; align-items: center; margin: 12px 20px 8px 24px; min-height: 72px; }
.sf-map__title {
    -unity-font-definition: url("../Fonts/Literata-SemiBold.asset");
    font-size: var(--fs-32);
    color: var(--plate-text);
}
.sf-map__headbutton { margin-left: 12px; color: var(--plate-text); border-color: var(--plate-dim); }
.sf-map__headbutton:enabled:hover { background-color: rgba(255, 255, 255, 0.06); }
.sf-map__view {
    flex-grow: 1;
    margin: 0 16px 16px 16px;
    overflow: hidden;
    border-radius: 6px;
    background-color: #CFC4AC;
}
.sf-map__sheet { -unity-background-scale-mode: stretch-to-fill; }
.sf-map__place {
    width: 40px;
    height: 40px;
    translate: -20px -20px;
    margin: 0;
    padding: 0;
    border-width: 0;
    border-radius: 20px;
    background-color: rgba(0, 0, 0, 0);
}
.sf-map__place:enabled:hover { background-color: rgba(0, 0, 0, 0); }
.sf-map__place:enabled:active { background-color: rgba(0, 0, 0, 0.08); }
.sf-map__dot {
    position: absolute;
    left: 11px;
    top: 11px;
    width: 18px;
    height: 18px;
    border-radius: 9px;
    border-width: 3px;
    border-color: var(--paper);
    background-color: var(--ink);
}
.sf-map__place--here .sf-map__dot { background-color: var(--rust); }
.sf-map__place--on .sf-map__dot { border-color: var(--ochre); width: 22px; height: 22px; left: 9px; top: 9px; border-radius: 11px; }
.sf-map__name {
    position: absolute;
    left: 36px;
    top: 4px;
    -unity-font-definition: url("../Fonts/Literata-SemiBold.asset");
    font-size: var(--fs-22);
    color: var(--ink);
    white-space: nowrap;
    text-shadow: 0 0 4px rgba(238, 230, 211, 0.95);
}
.sf-map__you { width: 40px; height: 40px; translate: -20px -20px; }
.sf-map__card {
    position: absolute;
    left: 16px;
    bottom: 16px;
    max-width: 460px;
    padding: 14px 18px 16px 18px;
}
.sf-map__card-title {
    -unity-font-definition: url("../Fonts/Literata-SemiBold.asset");
    font-size: var(--fs-30);
    color: var(--plate-text);
}
.sf-map__card-region {
    -unity-font-definition: url("../Fonts/Barlow-SemiBold.asset");
    font-size: var(--fs-20);
    letter-spacing: 2px;
    color: var(--plate-dim);
}
.sf-map__card-trip { font-size: var(--fs-24); margin-top: 8px; color: var(--plate-text); white-space: normal; }
.sf-map__travel { margin-top: 12px; align-self: flex-start; background-color: var(--ochre); color: var(--ink); }
.sf-map__travel:enabled:hover { background-color: #D59B3A; }

/* ---- item cells (ItemCells.cs): an item's drawing on a scrap of paper ---- */
.sf-cell {
    width: 96px;
    height: 96px;
    margin: 0 10px 10px 0;
    padding: 10px;
    border-width: 1px;
    border-color: var(--paper-edge);
    border-radius: 4px;
    background-color: #F4EEDF;
}
.sf-cell:enabled:hover { background-color: #F8F3E7; }
.sf-cell:enabled:active { background-color: var(--paper-deep); }
.sf-cell--on { border-width: 3px; border-color: var(--ochre); padding: 8px; }
.sf-cell--empty { background-color: rgba(244, 238, 223, 0.35); border-color: rgba(201, 185, 148, 0.7); }
.sf-cell--dim { opacity: 0.45; }
.sf-cell .sf-glyph { flex-grow: 1; }
.sf-cell__qty {
    position: absolute;
    right: 3px;
    top: 3px;
    padding: 0 5px;
    border-radius: 3px;
    background-color: rgba(244, 238, 223, 0.9);
    -unity-font-definition: url("../Fonts/Barlow-SemiBold.asset");
    font-size: var(--fs-18);
    color: var(--ink);
}
.sf-cell__cond {
    position: absolute;
    left: 8px;
    right: 8px;
    bottom: 5px;
    height: 5px;
    border-radius: 2px;
    background-color: rgba(36, 32, 27, 0.14);
}
.sf-cell__cond-fill { height: 100%; border-radius: 2px; background-color: var(--sage); }
.sf-cell__cond-fill--worn { background-color: var(--ochre); }
.sf-cell__cond-fill--failing { background-color: var(--rust); }

/* an item's figures (ItemCells.Row) */
.sf-stat {
    flex-direction: row;
    align-items: center;
    min-height: 34px;
    border-bottom-width: 1px;
    border-color: rgba(201, 185, 148, 0.6);
}
.sf-stat__label { width: 40%; font-size: var(--fs-21); color: var(--pencil); }
.sf-stat__value {
    flex-grow: 1;
    flex-shrink: 1;
    -unity-font-definition: url("../Fonts/Barlow-SemiBold.asset");
    font-size: var(--fs-22);
    color: var(--ink);
}
.sf-stat__delta { min-width: 92px; font-size: var(--fs-20); -unity-text-align: middle-right; }
.sf-stat__delta--better { color: var(--sage); }
.sf-stat__delta--worse { color: var(--rust); }

/* ---- the pack (PackScreen.cs): the figure on the desk, the items and the card on two pages ---- */
.sf-pack { background-color: #2B241E; }
.sf-pack__head { flex-direction: row; align-items: center; margin: 12px 20px 6px 20px; min-height: 72px; }
.sf-pack__title {
    -unity-font-definition: url("../Fonts/Literata-SemiBold.asset");
    font-size: var(--fs-34);
    color: var(--plate-text);
    margin-right: 22px;
}
.sf-pack__tolls {
    -unity-font-definition: url("../Fonts/Barlow-SemiBold.asset");
    font-size: var(--fs-24);
    letter-spacing: 1px;
    color: #E0A645;
    margin-right: 18px;
}
.sf-pack__close { color: var(--plate-text); border-color: var(--plate-dim); }
.sf-pack__close:enabled:hover { background-color: rgba(255, 255, 255, 0.06); }
.sf-pack__body { flex-grow: 1; flex-direction: row; margin: 0 16px; }
.sf-pack__doll {
    width: 300px;
    margin-right: 16px;
    border-radius: 6px;
    overflow: hidden;
    background-color: #3C342D;
}
.sf-pack__figure { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.sf-pack__slots { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.sf-pack__slot { position: absolute; width: 84px; height: 84px; margin: 0; padding: 8px; background-color: rgba(244, 238, 223, 0.9); }
.sf-pack__slot.sf-cell--on { padding: 6px; }
.sf-pack__slot.sf-cell--empty { background-color: rgba(244, 238, 223, 0.18); border-color: rgba(242, 234, 219, 0.35); }
.sf-pack__slot--active { border-width: 3px; border-color: var(--sage); padding: 6px; }
.sf-pack__slot--head { right: 12px; top: 14px; }
.sf-pack__slot--body { right: 12px; top: 136px; }
.sf-pack__slot--primary { left: 12px; bottom: 150px; }
.sf-pack__slot--secondary { left: 12px; bottom: 34px; }
.sf-pack__slot-label {
    position: absolute;
    left: -20px;
    right: -20px;
    bottom: -26px;
    -unity-font-definition: url("../Fonts/Barlow-SemiBold.asset");
    font-size: var(--fs-16);
    letter-spacing: 1px;
    color: var(--plate-dim);
    -unity-text-align: middle-center;
}
.sf-pack__pages { flex-grow: 1; flex-direction: row; background-color: var(--paper); border-radius: 6px; overflow: hidden; }
.sf-pack__grid-scroll { width: 52%; flex-shrink: 0; }
.sf-pack__grid-scroll .unity-scroll-view__content-container { padding: 16px 8px 16px 18px; }
.sf-pack__grid { flex-direction: row; flex-wrap: wrap; }
.sf-pack__right { flex-grow: 1; flex-shrink: 1; flex-basis: 0; }
.sf-pack__card-scroll { flex-grow: 1; flex-shrink: 1; flex-basis: 0; }
.sf-pack__card-scroll .unity-scroll-view__content-container { padding: 18px 24px 8px 22px; }
.sf-pack__card-top { flex-direction: row; align-items: center; }
.sf-pack__card-top .sf-glyph { width: 96px; height: 96px; margin-right: 14px; flex-shrink: 0; }
.sf-pack__card-names { flex-shrink: 1; }
.sf-pack__card-name {
    -unity-font-definition: url("../Fonts/Literata-SemiBold.asset");
    font-size: var(--fs-30);
    color: var(--ink);
    white-space: normal;
}
.sf-pack__card-sub { font-size: var(--fs-20); color: var(--pencil); margin-top: 2px; }
.sf-pack__card-desc {
    -unity-font-definition: url("../Fonts/Literata-Italic.asset");
    font-size: var(--fs-22);
    color: var(--ink-soft);
    white-space: normal;
    margin-top: 12px;
}
.sf-pack__against {
    -unity-font-definition: url("../Fonts/Barlow-SemiBold.asset");
    font-size: var(--fs-18);
    letter-spacing: 1px;
    color: var(--pencil);
    margin-top: 14px;
}
.sf-pack__stats { margin-top: 6px; }
.sf-pack__actions { flex-direction: row; flex-shrink: 0; padding: 10px 22px 14px 22px; border-top-width: 1px; border-color: rgba(201, 185, 148, 0.6); }
.sf-pack__act { margin-right: 12px; }
.sf-pack__foot { flex-direction: row; align-items: center; margin: 8px 20px 10px 20px; min-height: 36px; }
.sf-pack__meter { font-size: var(--fs-20); color: var(--plate-text); }
.sf-pack__meter--over { color: #E07A5F; }
.sf-pack__meter-track {
    width: 220px;
    height: 8px;
    margin: 0 18px;
    border-radius: 4px;
    background-color: rgba(242, 234, 219, 0.16);
}
.sf-pack__meter-fill { height: 100%; border-radius: 4px; background-color: var(--sage); }
.sf-pack__meter-fill--over { background-color: var(--rust); }
.sf-pack__message {
    flex-grow: 1;
    -unity-font-definition: url("../Fonts/Literata-Italic.asset");
    font-size: var(--fs-21);
    color: var(--plate-dim);
    -unity-text-align: middle-right;
}

/* ---- barter (BarterScreen.cs): their goods and your pack on two pages, the table between with the merchant across it ---- */
.sf-cell__deal {
    position: absolute;
    left: 3px;
    top: 3px;
    padding: 0 6px;
    border-radius: 3px;
    background-color: var(--ochre);
    -unity-font-definition: url("../Fonts/Barlow-SemiBold.asset");
    font-size: var(--fs-18);
    color: var(--ink);
}
.sf-barter { background-color: #2B241E; }
.sf-barter__body { flex-grow: 1; flex-direction: row; margin: 14px 16px 0 16px; }
.sf-barter__page { flex-grow: 1; flex-basis: 0; background-color: var(--paper); border-radius: 6px; }
.sf-barter__label {
    -unity-font-definition: url("../Fonts/Barlow-SemiBold.asset");
    font-size: var(--fs-18);
    letter-spacing: 2px;
    color: var(--plate-dim);
    margin: 8px 0 2px 0;
}
.sf-barter__label--page { color: var(--pencil); margin: 14px 18px 6px 18px; }
.sf-barter__scroll { flex-grow: 1; }
.sf-barter__scroll .unity-scroll-view__content-container { padding: 4px 6px 14px 18px; }
.sf-barter__grid { flex-direction: row; flex-wrap: wrap; }
.sf-barter__item { margin: 0 10px 12px 0; align-items: center; }
.sf-barter__item .sf-cell { margin: 0; }
.sf-barter__price {
    -unity-font-definition: url("../Fonts/Barlow-SemiBold.asset");
    font-size: var(--fs-18);
    color: var(--ink);
    margin-top: 2px;
}
.sf-barter__price--wont { -unity-font-definition: url("../Fonts/Barlow-Regular.asset"); color: var(--pencil); }
.sf-barter__table {
    width: 380px;
    margin: 0 14px;
    padding: 14px 16px;
    border-radius: 6px;
    background-color: #3C342D;
}
.sf-barter__who { flex-direction: row; align-items: center; }
.sf-barter__face {
    width: 92px;
    height: 92px;
    margin-right: 14px;
    border-radius: 46px;
    border-width: 3px;
    border-color: rgba(242, 234, 219, 0.25);
    overflow: hidden;
    background-color: #5C5146;
    justify-content: center;
    align-items: center;
    flex-shrink: 0;
}
.sf-barter__face Image { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.sf-barter__initial {
    -unity-font-definition: url("../Fonts/Literata-SemiBold.asset");
    font-size: var(--fs-48);
    color: var(--plate-text);
}
.sf-barter__names { flex-grow: 1; flex-shrink: 1; }
.sf-barter__name {
    -unity-font-definition: url("../Fonts/Literata-SemiBold.asset");
    font-size: var(--fs-30);
    color: var(--plate-text);
    white-space: normal;
}
.sf-barter__note { font-size: var(--fs-18); color: var(--plate-dim); white-space: normal; margin-top: 2px; }
.sf-barter__lines { flex-grow: 1; flex-shrink: 1; min-height: 150px; }
.sf-barter__line {
    flex-direction: row;
    align-items: center;
    min-height: 72px;
    border-bottom-width: 1px;
    border-color: rgba(242, 234, 219, 0.12);
}
.sf-barter__line-glyph { width: 44px; height: 44px; margin-right: 10px; flex-shrink: 0; }
.sf-barter__line-text { flex-grow: 1; flex-shrink: 1; font-size: var(--fs-21); color: var(--plate-text); white-space: normal; }
.sf-barter__line-dir { font-size: var(--fs-22); margin: 0 8px; color: #E0A645; }
.sf-barter__line--sell .sf-barter__line-dir { color: #9DB38F; }
.sf-barter__less {
    min-width: 72px;
    min-height: 64px;
    width: 72px;
    padding: 0;
    font-size: var(--fs-30);
    color: var(--plate-text);
    border-color: var(--plate-dim);
}
.sf-barter__less:enabled:hover { background-color: rgba(255, 255, 255, 0.06); }
.sf-barter__hint {
    -unity-font-definition: url("../Fonts/Literata-Italic.asset");
    font-size: var(--fs-20);
    color: var(--plate-dim);
    white-space: normal;
    margin-top: 10px;
}
.sf-barter__balance {
    -unity-font-definition: url("../Fonts/Barlow-SemiBold.asset");
    font-size: var(--fs-28);
    color: #E0A645;
    margin-top: 8px;
}
.sf-barter__balance--short { color: #E07A5F; }
.sf-barter__haggle { margin-top: 8px; }
.sf-barter__pill {
    align-self: flex-start;
    -unity-font-definition: url("../Fonts/Barlow-SemiBold.asset");
    font-size: var(--fs-18);
    letter-spacing: 1px;
    padding: 3px 10px;
    border-radius: 3px;
    background-color: var(--sage);
    color: var(--paper);
}
.sf-barter__pill--unmet { background-color: rgba(0, 0, 0, 0); border-width: 2px; border-color: #E07A5F; color: #E07A5F; }
.sf-barter__pill--spent { opacity: 0.5; }
.sf-barter__terms { font-size: var(--fs-18); color: var(--plate-dim); white-space: normal; margin-top: 4px; }
.sf-barter__buttons { flex-direction: row; flex-shrink: 0; margin: 8px -5px 0 -5px; }
.sf-barter__buttons .sf-button { flex-grow: 1; flex-basis: 0; margin: 0 5px; padding: 0 10px; }
.sf-barter__quiet { color: var(--plate-text); border-color: var(--plate-dim); }
.sf-barter__quiet:enabled:hover { background-color: rgba(255, 255, 255, 0.06); }
.sf-barter__deal { background-color: var(--ochre); color: var(--ink); }
.sf-barter__deal:enabled:hover { background-color: #D59B3A; }
.sf-barter__deal:disabled { background-color: var(--ochre); }
.sf-barter__message {
    min-height: 34px;
    margin: 6px 20px 10px 20px;
    -unity-font-definition: url("../Fonts/Literata-Italic.asset");
    font-size: var(--fs-21);
    color: var(--plate-dim);
    -unity-text-align: middle-center;
}

/* ---- character creation (CreationScreen.cs): the live figure on the left, the pages on paper on the right ---- */
.sf-creation { background-color: #2B241E; }
.sf-creation__body { flex-grow: 1; flex-direction: row; margin: 14px 16px; }
.sf-creation__stage {
    width: 40%;
    margin-right: 16px;
    border-radius: 6px;
    overflow: hidden;
    background-color: #3C342D;
}
.sf-creation__caption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 14px;
    -unity-font-definition: url("../Fonts/Literata-SemiBold.asset");
    font-size: var(--fs-30);
    color: var(--plate-text);
    -unity-text-align: middle-center;
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.7);
}
.sf-creation__paper { flex-grow: 1; flex-basis: 0; flex-shrink: 1; background-color: var(--paper); border-radius: 6px; overflow: hidden; }
.sf-creation__tabs {
    flex-direction: row;
    flex-shrink: 0;
    padding: 8px 12px 0 12px;
    border-bottom-width: 2px;
    border-color: var(--paper-edge);
}
.sf-creation__tab {
    min-height: 64px;
    margin: 0 4px 0 0;
    padding: 0 12px;
    border-width: 0;
    border-bottom-width: 3px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    -unity-font-definition: url("../Fonts/Barlow-SemiBold.asset");
    font-size: var(--fs-22);
    color: var(--pencil);
}
.sf-creation__tab:enabled:hover { background-color: var(--paper-deep); }
.sf-creation__tab--on { color: var(--ink); border-color: var(--ochre); }
.sf-creation__scroll { flex-grow: 1; flex-shrink: 1; flex-basis: 0; }
.sf-creation__scroll .unity-scroll-view__content-container { padding: 12px 22px 24px 22px; }
.sf-creation__heading {
    -unity-font-definition: url("../Fonts/Barlow-SemiBold.asset");
    font-size: var(--fs-18);
    letter-spacing: 2px;
    color: var(--pencil);
    margin: 16px 0 8px 0;
}
.sf-creation__note {
    -unity-font-definition: url("../Fonts/Literata-Regular.asset");
    font-size: var(--fs-22);
    color: var(--ink-soft);
    white-space: normal;
    margin-bottom: 6px;
}
.sf-creation__missing { color: var(--rust); -unity-font-definition: url("../Fonts/Literata-Italic.asset"); }
.sf-creation__row { flex-direction: row; flex-wrap: wrap; align-items: center; margin-bottom: 8px; }
.sf-creation__cards { flex-direction: row; flex-wrap: wrap; }
.sf-creation__chips { flex-direction: row; flex-wrap: wrap; margin: 8px 0 4px 0; }
.sf-creation__choice {
    min-height: 72px;
    min-width: 120px;
    margin: 0 10px 10px 0;
    padding: 8px 14px;
    border-width: 2px;
    border-color: var(--paper-edge);
    border-radius: 4px;
    background-color: #F4EEDF;
    align-items: flex-start;
    justify-content: center;
}
.sf-creation__cards .sf-creation__choice { width: 46%; }
.sf-creation__cards .sf-creation__choice--small { width: 30%; min-width: 0; }
.sf-creation__choice:enabled:hover { background-color: #F8F3E7; }
.sf-creation__choice--on { border-color: var(--ochre); border-width: 3px; padding: 7px 13px; background-color: #F8EFD9; }
.sf-creation__choice-text {
    -unity-font-definition: url("../Fonts/Barlow-SemiBold.asset");
    font-size: var(--fs-23);
    color: var(--ink);
    white-space: normal;
}
.sf-creation__choice-sub { font-size: var(--fs-18); color: var(--pencil); white-space: normal; margin-top: 2px; }
.sf-creation__chip { min-height: 56px; min-width: 0; padding: 4px 12px; margin: 0 8px 8px 0; }
.sf-creation__chip.sf-creation__choice--on { padding: 3px 11px; }
.sf-creation__action { margin: 0 10px 10px 0; }
.sf-creation__begin { min-width: 260px; background-color: var(--ochre); color: var(--ink); }
.sf-creation__begin:enabled:hover { background-color: #D59B3A; }
.sf-creation__field { margin: 0 0 4px 0; }
.sf-creation__field .unity-text-field__input {
    min-height: 64px;
    padding: 0 14px;
    border-width: 2px;
    border-color: var(--paper-edge);
    border-radius: 4px;
    background-color: #FBF7EE;
    -unity-font-definition: url("../Fonts/Literata-Regular.asset");
    font-size: var(--fs-28);
    color: var(--ink);
}
.sf-creation__slider { margin: 6px 0 4px 0; }
.sf-creation__slider-label { font-size: var(--fs-21); color: var(--ink-soft); margin: 4px 0 0 0; }
.sf-creation__slider-bar { margin: 0; min-height: 56px; }
.sf-creation__slider-bar .unity-base-slider__tracker {
    height: 6px;
    margin-top: -3px;
    border-width: 0;
    border-radius: 3px;
    background-color: var(--paper-edge);
}
.sf-creation__slider-bar .unity-base-slider__dragger {
    width: 34px;
    height: 34px;
    margin-top: -17px;
    border-width: 3px;
    border-color: var(--ink);
    border-radius: 17px;
    background-color: var(--paper);
}
.sf-creation__swatches { margin-bottom: 4px; }
.sf-creation__swatch {
    width: 64px;
    height: 64px;
    min-width: 64px;
    min-height: 64px;
    margin: 0 10px 8px 0;
    padding: 0;
    border-width: 2px;
    border-color: rgba(36, 32, 27, 0.25);
    border-radius: 32px;
}
.sf-creation__swatch--on { border-width: 4px; border-color: var(--ochre); }
.sf-creation__attr { flex-direction: row; align-items: center; flex-wrap: nowrap; min-height: 80px; border-bottom-width: 1px; border-color: rgba(201, 185, 148, 0.6); }
.sf-creation__attr-names { flex-grow: 1; flex-shrink: 1; }
.sf-creation__attr-name { -unity-font-definition: url("../Fonts/Barlow-SemiBold.asset"); font-size: var(--fs-24); color: var(--ink); }
.sf-creation__attr-desc { font-size: var(--fs-18); color: var(--pencil); white-space: normal; }
.sf-creation__attr-value {
    width: 64px;
    -unity-font-definition: url("../Fonts/Literata-SemiBold.asset");
    font-size: var(--fs-34);
    color: var(--ink);
    -unity-text-align: middle-center;
}
.sf-creation__step { min-width: 72px; width: 72px; min-height: 72px; padding: 0; font-size: var(--fs-32); }

/* ---- the title (TitleScreen.cs): a dark band down the left, the world behind ---- */
.sf-start { flex-direction: row; }
.sf-start__band {
    width: 44%;
    flex-grow: 0;
    flex-shrink: 0;
    padding: 0 0 0 56px;
    justify-content: center;
    background-color: rgba(18, 15, 12, 0.82);
    border-right-width: 2px;
    border-color: rgba(196, 138, 44, 0.55);
}
.sf-start__name {
    -unity-font-definition: url("../Fonts/Literata-SemiBold.asset");
    font-size: var(--fs-48);
    letter-spacing: 5px;
    color: var(--plate-text);
    white-space: normal;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.6);
}
.sf-start__rule { width: 120px; height: 3px; margin: 18px 0 26px 0; background-color: var(--ochre); }
.sf-start__choices { flex-direction: column; align-items: flex-start; }
.sf-start__choice {
    min-height: var(--touch);
    min-width: 340px;
    margin: 0 0 10px 0;
    padding: 6px 22px;
    border-width: 0;
    border-left-width: 3px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    align-items: flex-start;
    justify-content: center;
}
.sf-start__choice:enabled:hover { background-color: rgba(242, 234, 219, 0.08); border-color: var(--ochre); }
.sf-start__choice:enabled:active { background-color: rgba(242, 234, 219, 0.16); }
.sf-start__choice:enabled:focus { border-color: var(--ochre); }
.sf-start__choice:disabled { opacity: 0.4; }
.sf-start__choice-text {
    -unity-font-definition: url("../Fonts/Barlow-SemiBold.asset");
    font-size: var(--fs-32);
    letter-spacing: 1px;
    color: var(--plate-text);
}
.sf-start__choice-sub { font-size: var(--fs-21); color: var(--plate-dim); margin-top: 2px; white-space: normal; }
.sf-start__status {
    position: absolute;
    left: 56px;
    bottom: 28px;
    -unity-font-definition: url("../Fonts/Barlow-SemiBold.asset");
    font-size: var(--fs-20);
    letter-spacing: 2px;
    color: var(--plate-dim);
}

/* ---- the pause (PauseScreen.cs): the world stopped behind a scrim, a column of choices ---- */
.sf-pause { background-color: var(--scrim); justify-content: center; align-items: center; }
.sf-pause__column {
    min-width: 440px;
    padding: 26px 30px 18px 30px;
    border-radius: 6px;
    background-color: var(--plate);
    align-items: stretch;
}
.sf-pause__title {
    -unity-font-definition: url("../Fonts/Literata-SemiBold.asset");
    font-size: var(--fs-36);
    color: var(--plate-text);
    -unity-text-align: middle-center;
}
.sf-pause__line { font-size: var(--fs-21); color: var(--plate-dim); margin: 4px 0 16px 0; -unity-text-align: middle-center; white-space: normal; }
.sf-pause__choice {
    min-height: 72px;
    margin: 0 0 8px 0;
    border-width: 0;
    border-radius: 3px;
    background-color: rgba(242, 234, 219, 0.07);
    -unity-font-definition: url("../Fonts/Barlow-SemiBold.asset");
    font-size: var(--fs-26);
    letter-spacing: 1px;
    color: var(--plate-text);
}
.sf-pause__choice:enabled:hover { background-color: rgba(242, 234, 219, 0.14); }
.sf-pause__choice:enabled:active { background-color: rgba(242, 234, 219, 0.22); }
.sf-pause__choice:enabled:focus { border-width: 3px; border-color: var(--ochre); }
.sf-pause__choice:disabled { opacity: 0.4; }

/* ---- a question (ConfirmScreen) ---- */
.sf-confirm__row { flex-direction: row; justify-content: flex-end; margin-top: 22px; }
.sf-confirm__row .sf-button { margin-left: 12px; }
.sf-confirm__yes { background-color: var(--rust); color: var(--paper); }
.sf-confirm__yes:enabled:hover { background-color: #B5502F; }

/* ---- pages on the desk (SettingsScreen, SavesScreen; creation's paper, chips and headings) ---- */
.sf-menu__body { flex-grow: 1; margin: 14px 16px; }
.sf-menu__head {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    padding: 10px 16px 10px 22px;
    border-bottom-width: 2px;
    border-color: var(--paper-edge);
}
.sf-menu__title {
    flex-grow: 1;
    -unity-font-definition: url("../Fonts/Literata-SemiBold.asset");
    font-size: var(--fs-34);
    color: var(--ink);
}
.sf-menu__line { flex-direction: row; align-items: center; flex-wrap: wrap; margin: 2px 0 6px 0; }
.sf-menu__label { width: 30%; min-width: 220px; font-size: var(--fs-24); color: var(--ink-soft); white-space: normal; padding-right: 12px; }
.sf-menu__chips { flex-grow: 1; flex-shrink: 1; margin: 6px 0 0 0; }

/* ---- the saves (SavesScreen.cs): a card per slot with its picture ---- */
.sf-saves__grid { flex-direction: row; flex-wrap: wrap; }
.sf-saves__card {
    width: 48%;
    margin: 0 2% 16px 0;
    padding: 0;
    flex-direction: column;
    align-items: stretch;
    border-width: 2px;
    border-color: var(--paper-edge);
    border-radius: 4px;
    background-color: #F4EEDF;
    overflow: hidden;
}
.sf-saves__card:enabled:hover { border-color: var(--ochre); background-color: #F8F3E7; }
.sf-saves__card:enabled:focus { border-width: 3px; border-color: var(--ochre); }
.sf-saves__picture { height: 180px; background-color: #3C342D; }
.sf-saves__card--empty .sf-saves__picture { height: 80px; background-color: var(--paper-deep); }
.sf-saves__words { padding: 10px 14px 12px 14px; -unity-text-align: upper-left; }
.sf-saves__slot {
    -unity-font-definition: url("../Fonts/Barlow-SemiBold.asset");
    font-size: var(--fs-18);
    letter-spacing: 2px;
    color: var(--pencil);
}
.sf-saves__who {
    -unity-font-definition: url("../Fonts/Literata-Regular.asset");
    font-size: var(--fs-24);
    color: var(--ink);
    white-space: normal;
    margin-top: 2px;
}
.sf-saves__when { font-size: var(--fs-20); color: var(--ink-soft); margin-top: 2px; white-space: normal; }
.sf-saves__empty { -unity-font-definition: url("../Fonts/Literata-Italic.asset"); font-size: var(--fs-24); color: var(--ink-soft); margin-top: 2px; }

/* ---- the HUD's menu button (the pause), under the compass ---- */
.sf-hud__menu {
    position: absolute;
    right: 20px;
    top: 84px;
    width: 64px;
    height: 64px;
    min-width: 0;
    min-height: 0;
    padding: 0;
    margin: 0;
    border-width: 0;
    border-radius: 6px;
    background-color: var(--plate);
    align-items: center;
    justify-content: center;
}
.sf-hud__menu:enabled:hover { background-color: rgba(40, 35, 30, 0.86); }
.sf-hud__menu:enabled:active { background-color: rgba(8, 7, 6, 0.9); }

/* ---- a line for a moment over the HUD (Hud.Note) ---- */
.sf-hud__note {
    position: absolute;
    top: 20px;
    left: 38%;
    right: 38%;
    -unity-font-definition: url("../Fonts/Barlow-SemiBold.asset");
    font-size: var(--fs-22);
    color: var(--plate-text);
    -unity-text-align: middle-center;
}

/* ---- photo mode (PhotoScreen.cs): controls on a narrow plate, the frame as dark bands ---- */
.sf-photo__bands { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.sf-photo__band { position: absolute; background-color: rgba(0, 0, 0, 0.6); }
.sf-photo__safe { flex-grow: 1; }
.sf-photo__panel {
    position: absolute;
    left: 20px;
    top: 20px;
    bottom: 20px;
    width: 380px;
    padding: 14px 18px;
}
.sf-photo__title {
    -unity-font-definition: url("../Fonts/Literata-SemiBold.asset");
    font-size: var(--fs-30);
    color: var(--plate-text);
    margin-bottom: 4px;
}
.sf-photo__heading {
    -unity-font-definition: url("../Fonts/Barlow-SemiBold.asset");
    font-size: var(--fs-16);
    letter-spacing: 2px;
    color: var(--plate-dim);
    margin: 12px 0 4px 0;
}
.sf-photo__row { flex-direction: row; align-items: center; }
.sf-photo__value { width: 80px; font-size: var(--fs-22); color: var(--plate-text); -unity-text-align: middle-right; }
.sf-photo__slider { flex-grow: 1; margin: 0; min-height: 48px; }
.sf-photo__slider .unity-base-slider__tracker { height: 4px; margin-top: -2px; border-width: 0; border-radius: 2px; background-color: rgba(242, 234, 219, 0.35); }
.sf-photo__slider .unity-base-slider__dragger {
    width: 30px;
    height: 30px;
    margin-top: -15px;
    border-width: 2px;
    border-color: var(--plate-text);
    border-radius: 15px;
    background-color: var(--ochre);
}
.sf-photo__scroll { flex-grow: 1; flex-shrink: 1; flex-basis: 0; }
.sf-photo__scroll .unity-scroll-view__content-container { flex-shrink: 0; }
.sf-photo__scroll .unity-scroll-view__content-container > * { flex-shrink: 0; }
.sf-photo__chips { flex-direction: row; flex-wrap: wrap; flex-shrink: 0; }
.sf-photo__chip {
    min-height: 52px;
    min-width: 0;
    margin: 0 6px 6px 0;
    padding: 0 12px;
    border-width: 2px;
    border-color: rgba(242, 234, 219, 0.25);
    border-radius: 3px;
    background-color: rgba(242, 234, 219, 0.06);
    -unity-font-definition: url("../Fonts/Barlow-SemiBold.asset");
    font-size: var(--fs-20);
    color: var(--plate-text);
}
.sf-photo__chip:enabled:hover { background-color: rgba(242, 234, 219, 0.14); }
.sf-photo__chip:enabled:focus { border-color: var(--ochre); }
.sf-photo__chip--on { border-color: var(--ochre); background-color: rgba(196, 138, 44, 0.28); }
.sf-photo__actions { position: absolute; right: 20px; bottom: 20px; flex-direction: row; align-items: center; }
.sf-photo__take {
    min-width: 200px;
    min-height: 88px;
    margin: 0 0 0 12px;
    border-width: 0;
    border-radius: 44px;
    background-color: var(--ochre);
    -unity-font-definition: url("../Fonts/Barlow-SemiBold.asset");
    font-size: var(--fs-28);
    color: var(--ink);
}
.sf-photo__take:enabled:hover { background-color: #D59B3A; }
.sf-photo__take:enabled:focus { border-width: 3px; border-color: var(--plate-text); }
.sf-photo__small {
    min-height: 64px;
    min-width: 0;
    margin: 0 0 0 12px;
    padding: 0 20px;
    border-width: 0;
    border-radius: 6px;
    background-color: var(--plate);
    -unity-font-definition: url("../Fonts/Barlow-SemiBold.asset");
    font-size: var(--fs-22);
    color: var(--plate-text);
}
.sf-photo__small:enabled:hover { background-color: rgba(40, 35, 30, 0.86); }
.sf-photo__small:enabled:focus { border-width: 3px; border-color: var(--ochre); }
.sf-photo__show { position: absolute; right: 20px; top: 20px; opacity: 0.8; }
.sf-photo__note {
    position: absolute;
    bottom: 130px;
    left: 30%;
    right: 30%;
    padding: 10px 16px;
    border-radius: 6px;
    background-color: var(--plate);
    -unity-font-definition: url("../Fonts/Literata-Italic.asset");
    font-size: var(--fs-24);
    color: var(--plate-text);
    -unity-text-align: middle-center;
}

/* ---- focus (P5.3l: the pad moves the focus; the default theme's focused button is grey, so each kind keeps its own
   colour and shows focus by its border) ---- */
.sf-button:enabled:focus { background-color: var(--ink); }
.sf-button--quiet:enabled:focus { background-color: rgba(36, 32, 27, 0.08); }
.sf-button--plate:enabled:focus { background-color: var(--plate); }
.sf-creation__choice:enabled:focus { background-color: #F4EEDF; border-color: var(--ochre); }
.sf-creation__choice--on:enabled:focus { background-color: #F8EFD9; }
.sf-start__choice:enabled:focus { background-color: rgba(242, 234, 219, 0.08); }
.sf-pause__choice:enabled:focus { background-color: rgba(242, 234, 219, 0.14); }
.sf-photo__chip:enabled:focus { background-color: rgba(242, 234, 219, 0.06); border-color: var(--ochre); }
.sf-photo__chip--on:enabled:focus { background-color: rgba(196, 138, 44, 0.28); }
.sf-photo__small:enabled:focus { background-color: var(--plate); }
.sf-photo__take:enabled:focus { background-color: var(--ochre); }
.sf-hud__action:enabled:focus { background-color: var(--plate); }
.sf-saves__card:enabled:focus { background-color: #F4EEDF; }
.sf-photo__chip:enabled:active, .sf-photo__chip:enabled:hover:active { background-color: rgba(242, 234, 219, 0.2); }
.sf-photo__chip--on:enabled:active, .sf-photo__chip--on:enabled:hover, .sf-photo__chip--on:enabled:hover:active { background-color: rgba(196, 138, 44, 0.34); }

/* ---- a container open (LootScreen.cs): barter's pages, a narrow middle ---- */
.sf-loot__middle { width: 22%; min-width: 220px; margin: 0 14px; align-items: stretch; justify-content: center; }
.sf-loot__title {
    -unity-font-definition: url("../Fonts/Literata-SemiBold.asset");
    font-size: var(--fs-30);
    color: var(--plate-text);
    white-space: normal;
    -unity-text-align: middle-center;
    margin-bottom: 18px;
}
.sf-loot__all { margin-bottom: 10px; background-color: var(--ochre); color: var(--ink); }
.sf-loot__all:enabled:hover { background-color: #D59B3A; }
.sf-loot__all:enabled:focus { background-color: var(--ochre); }
.sf-loot__middle .sf-button--quiet { color: var(--plate-text); border-color: var(--plate-dim); }
.sf-loot__weight { margin-top: 18px; font-size: var(--fs-20); color: var(--plate-dim); -unity-text-align: middle-center; white-space: normal; }
.sf-loot__weight--over { color: #E07A5F; }
.sf-loot__empty { -unity-font-definition: url("../Fonts/Literata-Italic.asset"); font-size: var(--fs-22); color: var(--ink-soft); margin: 12px; }
