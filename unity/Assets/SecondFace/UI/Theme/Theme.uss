/* The Second Face: the one theme (BUILD_PLAN P5 step 3, DESIGN_UNITY §6 and §8).
   A field notebook and a map: paper, ink, pencil, a rust mark and an ochre highlight; plates of dark glass over the
   world for what stays on screen. Two OFL faces: Barlow for the interface, Literata for the notebook. No cursive.
   Units are panel pixels at the 1280x720 reference (scaled with the screen's height): on a 6.1-inch phone one unit is
   about 0.09 mm, so body text (26) is about 14 sp and a touch target (80) about 7 mm. */

:root {
    --paper: #EEE6D3;
    --paper-deep: #E3D8BF;
    --paper-edge: #C9B994;
    --ink: #24201B;
    --ink-soft: #4B433A;
    --pencil: #7C7266;
    --rust: #A1402A;
    --ochre: #C48A2C;
    --sage: #5D7354;
    --slate: #2E4A63;
    --plate: rgba(22, 19, 16, 0.78);
    --plate-text: #F2EADB;
    --plate-dim: #B9AE9C;
    --scrim: rgba(12, 10, 8, 0.55);

    --text-s: 22px;
    --text-m: 26px;
    --text-l: 32px;
    --text-xl: 42px;
    --text-title: 72px;
    --touch: 80px;
    --gutter: 16px;
    --edge: 24px;

    /* the default theme's text colours, so plain labels and fields read as ink */
    --unity-colors-default-text: #24201B;
    --unity-colors-label-text: #24201B;

    -unity-font-definition: url("../Fonts/Barlow-Regular.asset");
    font-size: 26px;
    color: #24201B;
}

/* ---- structure ---- */
.sf-row { flex-direction: row; align-items: center; }
.sf-col { flex-direction: column; }
.sf-grow { flex-grow: 1; }
.sf-safe { flex-grow: 1; }
.sf-edge { margin: var(--edge); }
.sf-gap { margin-right: var(--gutter); margin-bottom: var(--gutter); }

/* ---- surfaces ---- */
.sf-page { background-color: var(--paper); }
.sf-page--deep { background-color: var(--paper-deep); }
.sf-plate {
    background-color: var(--plate);
    border-radius: 6px;
    padding: 10px 16px;
}
.sf-plate Label { color: var(--plate-text); }
.sf-scrim { background-color: var(--scrim); }
.sf-rule { height: 2px; background-color: var(--paper-edge); margin: 12px 0; }

/* ---- type ---- */
.sf-title {
    -unity-font-definition: url("../Fonts/Literata-SemiBold.asset");
    font-size: var(--text-xl);
    color: var(--ink);
}
.sf-heading {
    -unity-font-definition: url("../Fonts/Barlow-SemiBold.asset");
    font-size: var(--text-l);
    color: var(--ink);
}
.sf-label {
    -unity-font-definition: url("../Fonts/Barlow-SemiBold.asset");
    font-size: var(--text-s);
    letter-spacing: 2px;
    color: var(--pencil);
}
.sf-body {
    -unity-font-definition: url("../Fonts/Barlow-Regular.asset");
    font-size: var(--text-m);
    white-space: normal;
}
.sf-book {
    -unity-font-definition: url("../Fonts/Literata-Regular.asset");
    font-size: var(--text-m);
    color: var(--ink);
    white-space: normal;
}
.sf-note {
    -unity-font-definition: url("../Fonts/Literata-Italic.asset");
    font-size: var(--text-m);
    color: var(--ink-soft);
    white-space: normal;
}
.sf-fine { font-size: var(--text-s); color: var(--pencil); white-space: normal; }
.sf-mark { color: var(--rust); }
.sf-lead { color: var(--slate); }

/* ---- buttons (selectors match the default theme's specificity so ours win) ---- */
.sf-button {
    min-height: var(--touch);
    min-width: var(--touch);
    padding: 0 28px;
    margin: 0;
    border-width: 0;
    border-radius: 3px;
    background-color: var(--ink);
    color: var(--paper);
    -unity-font-definition: url("../Fonts/Barlow-SemiBold.asset");
    font-size: var(--text-m);
    letter-spacing: 1px;
    -unity-text-align: middle-center;
}
.sf-button:enabled:hover { background-color: var(--ink-soft); }
.sf-button:enabled:active { background-color: #000000; }
.sf-button:enabled:focus { border-width: 3px; border-color: var(--ochre); }
.sf-button:disabled { opacity: 0.45; background-color: var(--ink); }
.sf-button--quiet { background-color: rgba(0, 0, 0, 0); color: var(--ink); border-width: 2px; border-color: var(--ink); }
.sf-button--quiet:enabled:hover { background-color: rgba(36, 32, 27, 0.08); }
.sf-button--quiet:enabled:active { background-color: rgba(36, 32, 27, 0.16); }
.sf-button--plate { background-color: var(--plate); color: var(--plate-text); }
.sf-button--plate:enabled:hover { background-color: rgba(40, 35, 30, 0.86); }
.sf-button--plate:enabled:active { background-color: rgba(8, 7, 6, 0.9); }

/* ---- the start card (TitleCard) ---- */
.sf-title-card { background-color: rgba(14, 12, 9, 0.45); }
.sf-title-card__body { justify-content: center; align-items: center; }
.sf-title-card__name {
    -unity-font-definition: url("../Fonts/Literata-SemiBold.asset");
    font-size: var(--text-title);
    letter-spacing: 6px;
    color: var(--plate-text);
    -unity-text-align: middle-center;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.6);
}
.sf-title-card__status {
    -unity-font-definition: url("../Fonts/Barlow-SemiBold.asset");
    font-size: var(--text-m);
    letter-spacing: 2px;
    margin-top: 18px;
    color: var(--plate-text);
    -unity-text-align: middle-center;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.7);
}
.sf-title-card__detail {
    font-size: var(--text-s);
    margin-top: 10px;
    max-width: 80%;
    color: var(--plate-dim);
    white-space: normal;
    -unity-text-align: middle-center;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.7);
}

/* ---- modal questions ---- */
.sf-modal { justify-content: center; align-items: center; background-color: var(--scrim); }
.sf-card {
    background-color: var(--paper);
    border-radius: 4px;
    padding: 28px 32px;
    max-width: 70%;
}

/* ---- the HUD (Hud.cs): plates over the world inside the safe area ---- */
.sf-hud__area { flex-grow: 1; }
.sf-hud__objective {
    position: absolute;
    left: 20px;
    top: 20px;
    max-width: 46%;
    padding: 10px 18px 12px 18px;
}
.sf-hud__when {
    -unity-font-definition: url("../Fonts/Barlow-SemiBold.asset");
    font-size: 20px;
    letter-spacing: 2px;
    color: var(--plate-dim);
}
.sf-hud__quest {
    -unity-font-definition: url("../Fonts/Barlow-SemiBold.asset");
    font-size: 22px;
    margin-top: 4px;
    color: #E0A645;
}
.sf-hud__line { font-size: 26px; margin-top: 2px; color: var(--plate-text); white-space: normal; }

.sf-compass {
    position: absolute;
    right: 20px;
    top: 20px;
    width: 360px;
    height: 52px;
    background-color: var(--plate);
    border-radius: 6px;
    overflow: hidden;
}
.sf-compass__letter {
    position: absolute;
    left: -16px;
    width: 32px;
    top: 6px;
    -unity-font-definition: url("../Fonts/Barlow-SemiBold.asset");
    font-size: 22px;
    -unity-text-align: upper-center;
    color: var(--plate-text);
}

.sf-hud__party { position: absolute; left: 20px; bottom: 20px; flex-direction: row; align-items: flex-end; }
.sf-hud__member {
    width: 100px;
    margin-right: 12px;
    padding: 6px 6px 8px 6px;
    align-items: center;
    background-color: var(--plate);
    border-radius: 6px;
}
.sf-hud__face {
    width: 80px;
    height: 80px;
    border-radius: 4px;
    border-width: 2px;
    border-color: rgba(242, 234, 219, 0.5);
    background-color: #3A332B;
    -unity-background-scale-mode: scale-and-crop;
    justify-content: center;
    align-items: center;
}
.sf-hud__member--leader .sf-hud__face { border-color: #E0A645; }
.sf-hud__initial {
    -unity-font-definition: url("../Fonts/Literata-SemiBold.asset");
    font-size: 40px;
    color: var(--plate-dim);
}
.sf-hud__name {
    -unity-font-definition: url("../Fonts/Barlow-SemiBold.asset");
    font-size: 20px;
    margin-top: 4px;
    color: var(--plate-text);
    -unity-text-align: upper-center;
}
.sf-hud__bar {
    align-self: stretch;
    height: 8px;
    margin-top: 4px;
    border-radius: 4px;
    background-color: rgba(0, 0, 0, 0.55);
}
.sf-hud__fill { height: 100%; border-radius: 4px; background-color: #7E9A6F; }
.sf-hud__fill--low { background-color: #D49A3A; }
.sf-hud__fill--critical { background-color: #C4553A; }

.sf-hud__actions { position: absolute; right: 20px; bottom: 20px; flex-direction: row; }
.sf-hud__action {
    width: 100px;
    height: 100px;
    margin: 0 0 0 12px;
    padding: 0;
    border-width: 0;
    border-radius: 8px;
    background-color: var(--plate);
    color: var(--plate-text);
    align-items: center;
    justify-content: center;
}
.sf-hud__action:enabled:hover { background-color: rgba(40, 35, 30, 0.86); }
.sf-hud__action:enabled:active { background-color: rgba(8, 7, 6, 0.9); }
.sf-hud__action:enabled:focus { border-width: 3px; border-color: var(--ochre); }
.sf-hud__action-label {
    -unity-font-definition: url("../Fonts/Barlow-SemiBold.asset");
    font-size: 20px;
    margin-top: 4px;
    color: var(--plate-text);
}
.sf-icon { color: var(--plate-text); }

/* ---- the radial action menu (RadialMenu.cs) ---- */
.sf-radial { background-color: rgba(10, 8, 6, 0.18); }
.sf-radial__ring {
    position: absolute;
    scale: 0.7 0.7;
    opacity: 0;
    transition-property: scale, opacity;
    transition-duration: 0.12s;
    transition-timing-function: ease-out;
}
.sf-radial--open .sf-radial__ring { scale: 1 1; opacity: 1; }
.sf-radial__verb {
    position: absolute;
    width: 104px;
    height: 104px;
    margin: 0;
    padding: 0;
    border-width: 0;
    border-radius: 52px;
    background-color: rgba(30, 26, 22, 0.95);
    color: var(--plate-text);
    align-items: center;
    justify-content: center;
}
.sf-radial__verb:enabled:hover { background-color: rgba(48, 42, 36, 0.97); }
.sf-radial__verb:enabled:active { background-color: rgba(8, 7, 6, 0.95); }
.sf-radial__verb:enabled:focus { border-width: 3px; border-color: var(--ochre); }
.sf-radial__verb:disabled { opacity: 0.4; background-color: rgba(30, 26, 22, 0.95); }
.sf-radial__verb .sf-icon { color: var(--plate-text); }
.sf-radial__verb-label {
    -unity-font-definition: url("../Fonts/Barlow-SemiBold.asset");
    font-size: 20px;
    margin-top: 2px;
    color: var(--plate-text);
}
.sf-radial__hub {
    position: absolute;
    max-width: 196px;
    padding: 6px 12px;
    border-radius: 6px;
    background-color: rgba(30, 26, 22, 0.95);
}
.sf-radial__title {
    -unity-font-definition: url("../Fonts/Barlow-SemiBold.asset");
    font-size: 22px;
    color: #E0A645;
    white-space: normal;
    -unity-text-align: middle-center;
}

/* ---- the conversation panel (DialoguePanel.cs): a page at the right, the scene beside it ---- */
.sf-dialogue { flex-direction: row; justify-content: flex-end; }
.sf-dialogue__page {
    width: 46%;
    min-width: 560px;
    background-color: var(--paper);
    border-left-width: 3px;
    border-left-color: var(--paper-edge);
}
.sf-dialogue__page > .sf-safe { flex-grow: 1; }
.sf-dialogue__head {
    flex-direction: row;
    align-items: center;
    margin: 20px 24px 8px 24px;
}
.sf-dialogue__face {
    width: 96px;
    height: 96px;
    border-radius: 4px;
    border-width: 2px;
    border-color: var(--paper-edge);
    background-color: #3A332B;
    -unity-background-scale-mode: scale-and-crop;
    justify-content: center;
    align-items: center;
}
.sf-dialogue__initial {
    -unity-font-definition: url("../Fonts/Literata-SemiBold.asset");
    font-size: 44px;
    color: var(--plate-dim);
}
.sf-dialogue__speaker {
    -unity-font-definition: url("../Fonts/Literata-SemiBold.asset");
    font-size: 32px;
    margin-left: 16px;
    flex-shrink: 1;
    white-space: normal;
    color: var(--ink);
}
.sf-dialogue__scroll { flex-grow: 1; flex-shrink: 1; }
.sf-dialogue__scroll .unity-scroll-view__content-container { padding: 4px 24px 24px 24px; }
.sf-dialogue__log { margin-bottom: 4px; }
.sf-dialogue__logged-line {
    -unity-font-definition: url("../Fonts/Literata-Regular.asset");
    font-size: 22px;
    color: var(--pencil);
    white-space: normal;
    margin-bottom: 6px;
}
.sf-dialogue__logged-choice {
    -unity-font-definition: url("../Fonts/Literata-Italic.asset");
    font-size: 22px;
    color: var(--pencil);
    white-space: normal;
    margin-bottom: 12px;
    padding-left: 16px;
}
.sf-dialogue__line {
    -unity-font-definition: url("../Fonts/Literata-Regular.asset");
    font-size: 28px;
    color: var(--ink);
    white-space: normal;
    margin: 6px 0 12px 0;
}
.sf-dialogue__passive {
    border-left-width: 3px;
    border-left-color: var(--slate);
    padding: 2px 0 2px 12px;
    margin-bottom: 12px;
}
.sf-dialogue__passive-label {
    -unity-font-definition: url("../Fonts/Barlow-SemiBold.asset");
    font-size: 20px;
    letter-spacing: 2px;
    color: var(--slate);
}
.sf-dialogue__passive-text {
    -unity-font-definition: url("../Fonts/Literata-Italic.asset");
    font-size: 24px;
    color: var(--ink-soft);
    white-space: normal;
}
.sf-dialogue__options { margin-top: 4px; }
.sf-dialogue__option {
    flex-direction: row;
    align-items: center;
    min-height: 72px;
    margin: 0;
    padding: 8px 12px;
    border-width: 0;
    border-bottom-width: 1px;
    border-color: var(--paper-edge);
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    -unity-text-align: middle-left;
}
.sf-dialogue__option:enabled:hover { background-color: var(--paper-deep); }
.sf-dialogue__option:enabled:active { background-color: #D8CBAE; }
.sf-dialogue__option:enabled:focus { border-left-width: 4px; border-left-color: var(--ochre); }
.sf-dialogue__option:disabled { opacity: 0.45; background-color: rgba(0, 0, 0, 0); }
.sf-dialogue__number {
    -unity-font-definition: url("../Fonts/Barlow-SemiBold.asset");
    font-size: 22px;
    min-width: 34px;
    color: var(--pencil);
}
.sf-dialogue__check {
    -unity-font-definition: url("../Fonts/Barlow-SemiBold.asset");
    font-size: 20px;
    letter-spacing: 1px;
    padding: 2px 8px;
    margin-right: 10px;
    border-radius: 3px;
    background-color: var(--sage);
    color: var(--paper);
}
.sf-dialogue__check--unmet { background-color: rgba(0, 0, 0, 0); border-width: 2px; border-color: var(--rust); color: var(--rust); }
.sf-dialogue__option-text {
    -unity-font-definition: url("../Fonts/Barlow-Regular.asset");
    font-size: 26px;
    flex-shrink: 1;
    white-space: normal;
    color: var(--ink);
}
.sf-dialogue__option--seen .sf-dialogue__option-text { color: var(--pencil); }
.sf-dialogue__option--exit .sf-dialogue__option-text { -unity-font-definition: url("../Fonts/Literata-Italic.asset"); }
